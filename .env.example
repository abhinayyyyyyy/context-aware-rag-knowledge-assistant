# ==============================================================================
# RAG Knowledge Assistant - Environment Configuration Template
# ==============================================================================

# LLM Provider Configuration ('ollama' or 'cloud')
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:latest

# Cloud LLM Settings (OpenAI-compatible endpoints)
# CLOUD_LLM_API_KEY=your-api-key-here
CLOUD_LLM_MODEL=gpt-4o-mini
CLOUD_LLM_BASE_URL=https://api.openai.com/v1

# Vector Store Configuration ('faiss' or 'postgres')
VECTOR_STORE=faiss

# Object Storage Configuration ('local' or 's3')
STORAGE_PROVIDER=local

# Local Filesystem Storage (Used when STORAGE_PROVIDER=local)
LOCAL_STORAGE_DIR=data/storage

# S3-Compatible Object Storage (Optional, used when STORAGE_PROVIDER=s3, e.g. AWS S3, MinIO, Cloudflare R2)
# S3_BUCKET_NAME=my-rag-documents
# S3_REGION_NAME=us-east-1
# S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=documents

# PostgreSQL Application State Persistence (Optional, defaults to false)
# When false: conversations and session state are managed in-memory via Streamlit
# When true: documents, conversations, and messages are persisted durably in PostgreSQL
PERSISTENCE_ENABLED=false

# PostgreSQL + pgvector Configuration (Optional, required when VECTOR_STORE=postgres or PERSISTENCE_ENABLED=true)
# DATABASE_URL=postgresql://user:password@localhost:5432/rag_assistant
# Or discrete parameters:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_assistant
POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
